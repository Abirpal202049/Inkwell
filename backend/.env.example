AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Realtime
COLLAB_JWT_SECRET=any-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# AI (Stage F)
GROQ_API_KEY=
