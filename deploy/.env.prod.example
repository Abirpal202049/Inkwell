# Production environment for docker-compose.prod.yml.
# On the VM: copy to the repo root as `.env` (next to docker-compose.prod.yml)
# and fill in real values. NEVER commit the filled-in file.

# Public domain (A record → the VM's static IP). Caddy gets TLS certs for it.
DOMAIN=docs.example.com

# Postgres superuser/owner — used by migrations only.
POSTGRES_PASSWORD=
# Non-owner app role (created on first boot; the backend connects as this
# so RLS applies). Changing it later requires ALTER ROLE in psql.
APP_DB_PASSWORD=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Realtime WS ticket signing — any long random string.
COLLAB_JWT_SECRET=

# Gemini (Google AI Studio). Empty → AI features hide themselves.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=

# Set by CI to pin the deployed images to Artifact Registry tags, e.g.
#   BACKEND_IMAGE=us-central1-docker.pkg.dev/PROJECT/inkwell/backend:SHA
# Left empty, compose falls back to locally built images.
BACKEND_IMAGE=
FRONTEND_IMAGE=
